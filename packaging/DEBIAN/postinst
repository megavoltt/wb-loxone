#!/bin/sh
# wb-loxone: после установки/обновления пакета
set -e
case "$1" in
    configure)
        systemctl daemon-reload >/dev/null 2>&1 || true
        systemctl enable wb-loxone.service >/dev/null 2>&1 || true
        # restart, а не enable --now: иначе уже активная служба старого кода
        # не перезапустится при обновлении пакета
        systemctl restart wb-loxone.service >/dev/null 2>&1 || true
        ;;
esac
exit 0
